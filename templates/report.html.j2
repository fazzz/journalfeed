<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<title>journalfeed レポート ({{ generated_at }})</title>
<style>
  :root {
    --bg: #faf9f7;
    --card-bg: #ffffff;
    --border: #e5e1da;
    --text: #2b2b28;
    --muted: #8a8478;
    --accent: #7a5c3e;
    --summary-ok: #2f5233;
    --summary-ok-bg: #eef4ee;
    --summary-pending: #8a8478;
    --summary-none: #a5443a;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    padding: 2rem 1.2rem 4rem;
    background: var(--bg);
    color: var(--text);
    font-family: "Hiragino Sans", "Yu Gothic", "Segoe UI", sans-serif;
    line-height: 1.7;
  }
  .wrap { max-width: 1180px; margin: 0 auto; }
  header { margin-bottom: 2.5rem; }
  header h1 { font-size: 1.5rem; margin: 0 0 0.3rem; }
  header p { color: var(--muted); margin: 0; font-size: 0.9rem; }
  .journal-section { margin-bottom: 2.4rem; scroll-margin-top: 8.5rem; }
  .journal-section h2 {
    font-size: 1.05rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.4rem;
    color: var(--accent);
  }
  .article-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.9rem;
    align-items: start;
  }
  @media (max-width: 720px) {
    .article-grid { grid-template-columns: 1fr; }
  }
  .toc {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    gap: 0.3rem 0.4rem;
    background: var(--bg);
    padding: 0.7rem 0.2rem 0.8rem;
    margin-bottom: 1.6rem;
    border-bottom: 1px solid var(--border);
    max-height: 7rem;
    overflow-y: auto;
  }
  .toc-item {
    font-size: 0.68rem;
    color: var(--accent);
    text-decoration: none;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.15rem 0.55rem;
    white-space: nowrap;
  }
  .toc-item:hover { background: var(--summary-ok-bg); }
  .toc-count { color: var(--muted); font-size: 0.64rem; margin-left: 0.1rem; }
  .article {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.7rem 1.1rem;
  }
  .meta { font-size: 0.82rem; color: var(--muted); margin-bottom: 0.6rem; }
  .summary { font-size: 0.92rem; margin: 0; padding: 0.55rem 0.7rem; border-radius: 6px; }
  .summary.summary-ok { background: var(--summary-ok-bg); color: var(--summary-ok); }
  .summary.summary-pending { color: var(--summary-pending); font-style: italic; background: transparent; padding-left: 0; }
  .summary.summary-none { color: var(--summary-none); font-style: italic; background: transparent; padding-left: 0; }
  .abstract-toggle { margin-top: 0.5rem; }
  .abstract-toggle summary {
    cursor: pointer;
    font-size: 0.8rem;
    color: var(--accent);
    user-select: none;
  }
  .abstract-toggle summary:hover { text-decoration: underline; }
  .abstract-text {
    font-size: 0.88rem;
    color: var(--text);
    margin: 0.5rem 0 0;
    padding-left: 0.7rem;
    border-left: 2px solid var(--border);
  }
  .export-btn {
    position: fixed;
    bottom: 1.4rem;
    right: 1.4rem;
    background: var(--accent);
    color: #fff;
    border: none;
    border-radius: 999px;
    padding: 0.8rem 1.4rem;
    font-size: 0.85rem;
    font-weight: bold;
    cursor: pointer;
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.2);
    z-index: 30;
  }
  .export-btn:hover { opacity: 0.92; }
  .export-btn:disabled { opacity: 0.5; cursor: default; }

  .toc-item.hot {
    background: #fbe6d3;
    border-color: #d98a3a;
    color: #a8531d;
    font-weight: bold;
  }
  .toc-fire { margin-left: 0.15rem; }

  .journal-section.hot h2 { color: #a8531d; }
  .journal-hot-badge {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: bold;
    color: #a8531d;
    background: #fbe6d3;
    border-radius: 4px;
    padding: 0.1rem 0.45rem;
    margin-left: 0.5rem;
    vertical-align: middle;
  }

  .article.kw-1 { border-left: 4px solid #d9b95c; }
  .article.kw-2 { border-left: 4px solid #d98a3a; background: #fffaf3; }
  .article.kw-3 { border-left: 4px solid #c1442b; background: #fff4f0; }
  .kw-badge-inline {
    display: inline-block;
    font-size: 0.68rem;
    color: #8a5a20;
    background: #fbe9c8;
    border-radius: 4px;
    padding: 0.05rem 0.4rem;
    margin-left: 0.4rem;
    white-space: normal;
  }
  .article.kw-3 .kw-badge-inline { color: #8f2c1a; background: #fddcd2; }

  .author-badge-inline {
    display: inline-block;
    font-size: 0.68rem;
    color: #7a5c00;
    background: #fdf1c8;
    border: 1px solid #e8cf7a;
    border-radius: 4px;
    padding: 0.05rem 0.4rem;
    margin-left: 0.4rem;
    white-space: normal;
  }

  .article.kw-0 .collapsed-title { font-size: 0.86rem; color: var(--muted); }
  .article.kw-0 .meta { font-size: 0.76rem; }
  .article.kw-0 .summary { font-size: 0.85rem; }
  .article.kw-0 .abstract-toggle summary { font-size: 0.74rem; }
  .article.kw-0 .abstract-text { font-size: 0.8rem; }

  .article-collapsed-summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
  }
  .article-collapsed-summary::-webkit-details-marker { display: none; }
  .article-collapsed-summary input[type="checkbox"] {
    margin-top: 0.3rem;
    flex-shrink: 0;
    width: 1rem;
    height: 1rem;
    accent-color: var(--accent);
  }
  .collapsed-title-wrap { line-height: 1.5; }
  .collapsed-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
  }
  .collapsed-title:hover { text-decoration: underline; }
  .article-collapsed-body { margin-top: 0.65rem; padding-top: 0.1rem; }
  footer { text-align: center; color: var(--muted); font-size: 0.8rem; margin-top: 3rem; }
</style>
</head>
<body>
<div class="wrap">
  <header>
    <h1>journalfeed レポート</h1>
    <p>生成日: {{ generated_at }} / 直近 {{ lookback_days }} 日分・{{ total_count }} 件</p>
  </header>

  {% if not grouped %}
    <p>この期間に該当する記事はありません。</p>
  {% endif %}

  {% if grouped %}
  <nav class="toc">
    {% for g in grouped %}
    <a href="#journal-{{ g.slug }}" class="toc-item{% if g.is_hot %} hot{% endif %}" title="{{ g.journal }}">{{ g.display_name }}<span class="toc-count">({{ g.count }})</span>{% if g.is_hot %}<span class="toc-fire">🔥</span>{% endif %}</a>
    {% endfor %}
  </nav>
  {% endif %}

  {% for g in grouped %}
  <section class="journal-section{% if g.is_hot %} hot{% endif %}" id="journal-{{ g.slug }}">
    <h2 title="{{ g.journal }}">{{ g.display_name }} ({{ g.count }}){% if g.is_hot %}<span class="journal-hot-badge">🔥 ヒット多数({{ g.hit_articles }}/{{ g.count }})</span>{% endif %}</h2>
    <div class="article-grid">
    {% for a in g.articles %}
    <article class="article kw-{{ a.display_tier }}">
      <details>
        <summary class="article-collapsed-summary">
          <input type="checkbox" class="select-doi" data-doi="{{ a.doi }}" onclick="event.stopPropagation()">
          <span class="collapsed-title-wrap">
            <a class="collapsed-title" href="{{ a.link }}" target="_blank" rel="noopener" onclick="event.stopPropagation()">{{ a.title }}</a>
            {% if a.author_hits %}<span class="author-badge-inline">⭐ {{ a.author_hits|join(", ") }}</span>{% endif %}
            {% if a.keyword_hits %}<span class="kw-badge-inline">🔑 {{ a.keyword_hits|join(", ") }}</span>{% endif %}
          </span>
        </summary>
        <div class="article-collapsed-body">
          <div class="meta">
            {% if a.authors %}{{ a.authors }} ・ {% endif %}{{ a.pub_date or "日付不明" }}
          </div>
          <p class="summary summary-{{ a.summary_kind }}">{{ a.summary }}</p>
          {% if a.abstract %}
          <details class="abstract-toggle">
            <summary>Abstractを表示</summary>
            <p class="abstract-text">{{ a.abstract }}</p>
          </details>
          {% endif %}
        </div>
      </details>
    </article>
    {% endfor %}
    </div>
  </section>
  {% endfor %}

  <footer>journalfeed によって自動生成されました。</footer>

  <button id="export-btn" class="export-btn" disabled>
    選択した論文を書き出す (<span id="selected-count">0</span>)
  </button>
</div>

<script>
(function () {
  var checkboxes = document.querySelectorAll('.select-doi');
  var countEl = document.getElementById('selected-count');
  var exportBtn = document.getElementById('export-btn');

  function updateState() {
    var n = document.querySelectorAll('.select-doi:checked').length;
    countEl.textContent = n;
    exportBtn.disabled = n === 0;
  }

  checkboxes.forEach(function (cb) {
    cb.addEventListener('change', updateState);
  });
  updateState();

  exportBtn.addEventListener('click', function () {
    var dois = Array.prototype.slice
      .call(document.querySelectorAll('.select-doi:checked'))
      .map(function (cb) { return cb.getAttribute('data-doi'); });

    if (dois.length === 0) return;

    var blob = new Blob([dois.join('\n') + '\n'], { type: 'text/plain' });
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    a.href = url;
    a.download = 'selected_dois.txt';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  });
})();
</script>
</body>
</html>
